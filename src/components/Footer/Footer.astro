---
import { Icon } from "astro-icon/components";
import { getEntry } from "astro:content";

const data = await getEntry("data", "data");
---

<footer class="mt-16 border-t-2 border-surface0 pt-8">
  <div class="flex flex-col items-center gap-6 text-center md:items-start md:text-left">
    <div class="flex flex-row gap-6 text-2xl">
      {
        data.data.links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            class="transition-colors hover:text-subtext0"
            aria-label={link.name}
          >
            <Icon name={`fa6-brands:${link.name}`} />
          </a>
        ))
      }
    </div>
    <p class="text-sm text-subtext0">
      Copyright © {new Date().getFullYear()} - {data.data.fullName}
    </p>
    <p class="text-xs text-overlay0">This website is still a work in progress.</p>
  </div>
</footer>
